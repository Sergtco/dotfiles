# Written by hand rather than generated by `nixos-generate-config`: the Deck's
# hardware is known ahead of time, and the mounts come from disko (see
# disk-config.nix) rather than from a scan of a disk that does not exist yet.
# Worth diffing against `nixos-generate-config --show-hardware-config` once the
# machine is up.
_: {
  flake.nixosModules.steamdeck =
    {
      config,
      lib,
      modulesPath,
      ...
    }:
    {
      imports = [ (modulesPath + "/installer/scan/not-detected.nix") ];

      # `jovian.devices.steamdeck.enableDefaultStage1Modules` adds the Deck's
      # own stage 1 modules (hid, the card reader, ...) on top of these.
      boot.initrd.availableKernelModules = [
        "nvme"
        "xhci_pci"
        "usbhid"
        "usb_storage"
        "sd_mod"
        "sdhci_pci"
      ];
      boot.initrd.kernelModules = [ ];
      boot.kernelModules = [ "kvm-amd" ];
      boot.extraModulePackages = [ ];

      hardware.enableRedistributableFirmware = true;

      # `fileSystems` and `swapDevices` are deliberately absent: disko derives
      # both from the partition table in disk-config.nix.

      networking.useDHCP = lib.mkDefault true;

      nixpkgs.hostPlatform = lib.mkDefault "x86_64-linux";
      hardware.cpu.amd.updateMicrocode = lib.mkDefault config.hardware.enableRedistributableFirmware;
    };
}
